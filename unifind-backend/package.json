{
  "name": "unifind-backend",
  "version": "0.1.0",
  "private": true,
  "description": "UniFind MVP backend \u2013 Node.js + Express microservices behind an API gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "gateway",
    "services/*"
  ],
  "scripts": {
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/migrate.js --reset && node db/seed.js",
    "dev": "node scripts/dev.js --watch",
    "start": "node scripts/dev.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}