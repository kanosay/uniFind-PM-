NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://unifind:unifind@localhost:5432/unifind
DATABASE_SSL=false

# Auth (change in any shared/deployed environment!)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Optional: created by `npm run db:seed` if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ports
GATEWAY_PORT=3000
AUTH_PORT=3001
UNIVERSITY_PORT=3002
RATING_PORT=3003
TEST_PORT=3004
BLOG_PORT=3005
AUDIT_PORT=3006

# Browser origin of the React app (CORS)
CORS_ORIGIN=http://localhost:5173
